# ============================================================
# activia-trace backend -- variables de entorno base
# Copiar como .env y completar con valores reales.
# NUNCA versionar .env con secretos reales.
# ============================================================

# ---- Base de datos ----
DATABASE_URL=postgresql+asyncpg://trace:trace@localhost:5432/trace_dev
DATABASE_URL_TEST=postgresql+asyncpg://trace:trace@localhost:5432/trace_test

# ---- Seguridad ----
# SECRET_KEY: minimo 32 caracteres para firma JWT
SECRET_KEY=change-me-generate-with-secrets-token-hex-32-chars-minimum

# ENCRYPTION_KEY: exactamente 32 caracteres para AES-256
ENCRYPTION_KEY=change-me-exactly-32-chars-aes256!!

# ---- Tokens ----
ACCESS_TOKEN_EXPIRE_MINUTES=15

# ---- Entorno ----
APP_ENV=development

# ---- OpenTelemetry (opcional) ----
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
