# active-trace backend — variables de entorno requeridas
# Copiar a .env y completar con valores reales.
# NUNCA commitear .env con secretos reales.

# ---- Base de datos ----
DATABASE_URL=postgresql+asyncpg://trace:trace@localhost:5432/trace
DATABASE_URL_TEST=postgresql+asyncpg://trace:trace@localhost:5432/trace_test

# ---- Seguridad ----
# SECRET_KEY: clave de firma JWT. Minimo 32 caracteres.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-at-least-32-chars-random-secret

# ENCRYPTION_KEY: clave AES-256 para cifrado en reposo de PII (DNI, CUIL, CBU, email).
# Debe tener EXACTAMENTE 32 caracteres ASCII (256 bits).
# Generar con: python -c "import secrets; print(secrets.token_hex(16))"  # 32 hex chars
# Ejemplo (NO usar en produccion): 12345678901234567890123456789012
ENCRYPTION_KEY=replace-me-with-exactly-32-chars!!

# ---- Tokens ----
ACCESS_TOKEN_EXPIRE_MINUTES=15

# ---- Entorno ----
# Valores posibles: development | test | production
APP_ENV=development

# ---- OpenTelemetry (opcional) ----
# Dejar en blanco para deshabilitar exportacion de trazas
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
